+
+    rwkv_ensure_serial_sched(ctx);
 
     rwkv_set_inputs(ctx, ctx->serial_graph, state_in);
     ggml_backend_tensor_set(ctx->serial_graph.tokens, &token, 0, rwkv_tensor_nbytes(ctx->serial_graph.tokens));
