diff --git a/src/ggml-cuda/wkv7.cu b/src/ggml-cuda/wkv7.cu
new file mode 100644
index 00000000..4011fd24
--- /dev/null
+++ b/src/ggml-cuda/wkv7.cu
@@ -0,0 +1,101 @@
+// RWKV-7 time mixing on CUDA, ported from upstream ggml (src/ggml-cuda/wkv.cu, rwkv_wkv7_f32).
+// One block per (sequence, head); one thread per row of that head's S x S state.
+#include "common.cuh"
+#include "wkv7.cuh"
+
+template <int block_size>
+static __global__ void rwkv_wkv7_f32(const int B, const int T, const int C, const int H, const float * r, const float * w, const float * k, const float * v, const float * a, const float * b, const float * s, float * dst) {
+    const int tid = threadIdx.x;
+    const int bid = blockIdx.x;
+
+    const int head_size = block_size;
+    const int batch_i = bid / H;
+    const int head_i = bid % H;
+    const int state_size = C * head_size;
+    const int n_seq_tokens = T / B;
+
+    float state[head_size];
+    __shared__ float _r[head_size], _w[head_size], _k[head_size], _a[head_size], _b[head_size];
+
+    #pragma unroll
+    for (int i = 0; i < head_size; i++) {
+        state[i] = s[batch_i * state_size + head_i * head_size * head_size + tid * head_size + i];
+    }
+
+    for (int t = batch_i * n_seq_tokens * C + head_i * head_size + tid; t < (batch_i + 1) * n_seq_tokens * C + head_i * head_size + tid; t += C) {
+        __syncthreads();
+        _r[tid] = r[t];
+        _w[tid] = w[t];
+        _k[tid] = k[t];
+        _a[tid] = a[t];
+        _b[tid] = b[t];
+        __syncthreads();
+
+        float sa = 0;
+        #pragma unroll
+        for (int j = 0; j < head_size; j += 4) {
+            const float4 & av = (float4 &)(_a[j]);
+            const float4 & sv = (float4 &)(state[j]);
+            sa += av.x * sv.x;
+            sa += av.y * sv.y;
+            sa += av.z * sv.z;
+            sa += av.w * sv.w;
+        }
+
+        const float _v = v[t];
+        float y = 0;
+        #pragma unroll
+        for (int j = 0; j < head_size; j += 4) {
+            const float4 & rv = (float4 &)(_r[j]);
+            const float4 & wv = (float4 &)(_w[j]);
+            const float4 & kv = (float4 &)(_k[j]);
+            const float4 & bv = (float4 &)(_b[j]);
+            float4 & sv = (float4 &)(state[j]);
+
+            sv.x = sv.x * wv.x + kv.x * _v + sa * bv.x;
+            sv.y = sv.y * wv.y + kv.y * _v + sa * bv.y;
+            sv.z = sv.z * wv.z + kv.z * _v + sa * bv.z;
+            sv.w = sv.w * wv.w + kv.w * _v + sa * bv.w;
+
+            y += sv.x * rv.x;
+            y += sv.y * rv.y;
+            y += sv.z * rv.z;
+            y += sv.w * rv.w;
+        }
+        dst[t] = y;
+    }
+
+    #pragma unroll
+    for (int i = 0; i < head_size; i++) {
+        dst[T * C + batch_i * state_size + head_i * head_size * head_size + tid * head_size + i] = state[i];
+    }
+}
+
+void ggml_cuda_op_rwkv_wkv7(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const float * r_d = (const float *) dst->src[0]->data;
+    const float * w_d = (const float *) dst->src[1]->data;
+    const float * k_d = (const float *) dst->src[2]->data;
+    const float * v_d = (const float *) dst->src[3]->data;
+    const float * a_d = (const float *) dst->src[4]->data;
+    const float * b_d = (const float *) dst->src[5]->data;
+    const float * s_d = (const float *) dst->src[6]->data;
+
+    const int64_t B = dst->src[6]->ne[1];
+    const int64_t T = dst->src[0]->ne[2];
+    const int64_t C = dst->ne[0];
+    const int64_t H = dst->src[0]->ne[1];
+
+    float * dst_d = (float *) dst->data;
+
+    cudaStream_t stream = ctx.stream();
+
+    GGML_ASSERT(dst->src[6]->type == GGML_TYPE_F32);
+    GGML_ASSERT(C % H == 0);
+    GGML_ASSERT(C / H == CUDA_WKV7_BLOCK_SIZE || C / H == CUDA_WKV7_BLOCK_SIZE * 2);
+
+    if (C / H == CUDA_WKV7_BLOCK_SIZE) {
+        rwkv_wkv7_f32<CUDA_WKV7_BLOCK_SIZE><<<B * H, C / H, 0, stream>>>(B, T, C, H, r_d, w_d, k_d, v_d, a_d, b_d, s_d, dst_d);
+    } else {
+        rwkv_wkv7_f32<CUDA_WKV7_BLOCK_SIZE * 2><<<B * H, C / H, 0, stream>>>(B, T, C, H, r_d, w_d, k_d, v_d, a_d, b_d, s_d, dst_d);
+    }
+}
